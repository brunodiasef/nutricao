/* ============ helpers de SVG ============ */
const NS='http://www.w3.org/2000/svg';
function el(t,at={},kids=[]){const e=document.createElementNS(NS,t);
  for(const k in at) e.setAttribute(k,at[k]); kids.forEach(k=>e.appendChild(k)); return e;}
const tip = document.getElementById('tip');
function showTip(ev,html){tip.innerHTML=html;tip.style.opacity=1;moveTip(ev);}
function moveTip(ev){const r=tip.getBoundingClientRect();
  let x=ev.clientX+16,y=ev.clientY+16;
  if(x+r.width>innerWidth-10)x=ev.clientX-r.width-16;
  if(y+r.height>innerHeight-10)y=ev.clientY-r.height-16;
  tip.style.left=x+'px';tip.style.top=y+'px';}
function hideTip(){tip.style.opacity=0;}
function bindTip(node,html){
  node.addEventListener('mouseenter',e=>showTip(e,html));
  node.addEventListener('mousemove',moveTip);
  node.addEventListener('mouseleave',hideTip);
  node.addEventListener('focus',e=>showTip({clientX:node.getBoundingClientRect().left,clientY:node.getBoundingClientRect().top},html));
  node.addEventListener('blur',hideTip);
}

/* ============ gráfico de curvas OMS ============ */
function curvaOMS(opts){
  const W=920,H=560,ml=52,mr=18,mt=18,mb=44;
  const x0=61,x1=228,y0=10,y1=42;
  const px=m=>ml+(m-x0)/(x1-x0)*(W-ml-mr);
  const py=v=>mt+(1-(v-y0)/(y1-y0))*(H-mt-mb);
  const svg=el('svg',{viewBox:`0 0 ${W} ${H}`,role:'img',
    'aria-label':'Curva de IMC por idade da OMS com os alunos medidos'});

  for(let v=10;v<=40;v+=5){
    svg.appendChild(el('line',{x1:ml,x2:W-mr,y1:py(v),y2:py(v),class:'gridline'}));
    svg.appendChild(el('text',{x:ml-9,y:py(v)+4,class:'axis','text-anchor':'end'})).textContent=v;
  }
  for(let a=5;a<=19;a++){
    const m=a*12;
    svg.appendChild(el('text',{x:px(m),y:H-mb+20,class:'axis','text-anchor':'middle'})).textContent=a;
  }
  svg.appendChild(el('text',{x:(W+ml)/2,y:H-6,class:'axis','text-anchor':'middle'})).textContent='idade (anos)';
  svg.appendChild(el('text',{x:ml-9,y:mt-4,class:'axis','text-anchor':'end'})).textContent='IMC';

  const cv=CURVAS[opts.sexo];
  const faixas=[['sd2n','var(--magreza)','−2'],['sd0','var(--eutrofia)','mediana'],
                ['sd1','var(--sobrepeso)','+1'],['sd2','var(--obesidade)','+2'],['sd3','var(--grave)','+3']];
  faixas.forEach(([k,cor,rot])=>{
    const d=cv.m.map((m,i)=>`${i?'L':'M'}${px(m).toFixed(1)},${py(cv[k][i]).toFixed(1)}`).join(' ');
    svg.appendChild(el('path',{d,fill:'none',stroke:cor,'stroke-width':1.4,'stroke-opacity':.55,
      'stroke-dasharray':k==='sd0'?'':'5 4'}));
    const last=cv[k].length-1;
    svg.appendChild(el('text',{x:px(cv.m[last])+4,y:py(cv[k][last])+4,class:'axis',fill:cor})).textContent=rot;
  });

  const pts=A.filter(a=>a.z!==null && a.s===opts.sexo && opts.cats.has(a.c)
                        && (opts.turma==='__all'||a.t===opts.turma));
  pts.forEach(a=>{
    const c=el('circle',{cx:px(a.m).toFixed(1),cy:py(Math.min(a.i,y1-.4)).toFixed(1),r:4.6,
      fill:CAT[a.c].c,'fill-opacity':.8,class:'dot',tabindex:0,role:'img',
      'aria-label':`${nome(a)}, IMC ${br(a.i)}, ${CAT[a.c].n}`});
    bindTip(c,`<b>${nome(a)}</b><span class="m">${a.t} · ${a.a} anos<br>
      ${br(a.p)} kg · ${a.h} cm · IMC ${br(a.i)}<br>escore-z ${br(a.z.toFixed(2))}</span>
      <span style="color:${CAT[a.c].c}">${CAT[a.c].n}</span>`);
    svg.appendChild(c);
  });
  return {svg,n:pts.length};
}

/* ============ barras horizontais ============ */
function barras(itens,{max,cor,rotulo}={}){
  const wrap=document.createElement('div');
  const mx=max||Math.max(...itens.map(i=>i.v));
  itens.forEach(it=>{
    const row=document.createElement('div');
    row.style.cssText='display:grid;grid-template-columns:minmax(84px,26%) 1fr auto;gap:12px;align-items:center;padding:5px 0';
    const l=document.createElement('span'); l.textContent=it.k;
    l.style.cssText='font-size:.84rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis';
    const track=document.createElement('div');
    track.style.cssText='height:16px;background:rgba(233,241,237,.06);border-radius:4px;overflow:hidden';
    const fill=document.createElement('div');
    fill.style.cssText=`height:100%;width:${(100*it.v/mx).toFixed(1)}%;background:${it.cor||cor||'var(--eutrofia)'};border-radius:4px`;
    track.appendChild(fill);
    const v=document.createElement('span');
    v.textContent=rotulo?rotulo(it):it.v;
    v.style.cssText='font-size:.84rem;font-variant-numeric:tabular-nums;min-width:52px;text-align:right';
    row.append(l,track,v);
    if(it.tip) bindTip(row,it.tip);
    wrap.appendChild(row);
  });
  return wrap;
}

