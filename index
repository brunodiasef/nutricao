<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diagnóstico Nutricional — EEEFM Ilda Ferreira da Fonseca Martins</title>
<style>
:root{
  --bg:#0B1F1B; --surf:#12302A; --surf2:#0F2621;
  --ink:#E9F1ED; --muted:#9DB3AB; --line:rgba(233,241,237,.14);
  --magreza:#4FA3D9; --eutrofia:#7FBF6A; --sobrepeso:#EBB13E;
  --obesidade:#E27A45; --grave:#D2495B; --pendente:#6E8880; --verificar:#B98CD6;
  --serif:"Charter","Bitstream Charter","Palatino Linotype",Palatino,Georgia,serif;
  --sans:Candara,Optima,"Trebuchet MS","Segoe UI",system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
  font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;overflow:hidden}
h1,h2,h3{font-family:var(--serif);font-weight:600;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(2.4rem,5.2vw,4.4rem);line-height:1.02}
h2{font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.1}
p{margin:0 0 .8em}
.lead{font-size:clamp(1rem,1.35vw,1.18rem);color:var(--muted);max-width:60ch}
b{font-weight:600;color:var(--ink)}

/* ---------- estrutura ---------- */
#deck{height:100%;position:relative}
.slide{position:absolute;inset:0;padding:clamp(26px,4vh,52px) clamp(26px,4.2vw,68px) 92px;
  display:flex;flex-direction:column;overflow:auto}
.slide > *{flex:1;min-height:0}
.slide .pane{animation:rise .5s cubic-bezier(.2,.7,.3,1) both}
.slide .pane:last-child{animation-delay:.1s}
@media (prefers-reduced-motion:reduce){.slide .pane{animation:none}*{transition:none!important}}

.eyebrow{font-family:var(--serif);font-style:italic;color:var(--muted);font-size:1.02rem}
.split{display:grid;grid-template-columns:minmax(280px,34%) 1fr;gap:clamp(20px,3vw,48px);
  flex:1;min-height:0;align-items:stretch}
.split.wide{grid-template-columns:minmax(260px,29%) 1fr}
.pane{min-width:0;min-height:0;display:flex;flex-direction:column;gap:14px;justify-content:center}

/* ---------- barra inferior ---------- */
#bar{position:fixed;left:0;right:0;bottom:0;height:64px;display:flex;align-items:center;
  gap:18px;padding:0 clamp(20px,4.4vw,72px);background:linear-gradient(transparent,var(--bg) 42%);
  z-index:40}
#dots{display:flex;gap:7px;flex:1;flex-wrap:wrap}
#dots button{width:26px;height:5px;border:0;border-radius:3px;background:var(--line);cursor:pointer;padding:0}
#dots button[aria-current="true"]{background:var(--eutrofia);width:38px}
#dots button:focus-visible,.ctl:focus-visible,.nav:focus-visible,.tab:focus-visible,
.chk:focus-visible,select:focus-visible{outline:2px solid var(--sobrepeso);outline-offset:3px}
.nav{background:transparent;border:1px solid var(--line);color:var(--ink);width:38px;height:38px;
  border-radius:50%;cursor:pointer;font-size:15px;line-height:1}
.nav:hover{border-color:var(--eutrofia);color:var(--eutrofia)}
.ctl{background:transparent;border:1px solid var(--line);color:var(--muted);
  padding:7px 13px;border-radius:999px;cursor:pointer;font:inherit;font-size:.83rem}
.ctl[aria-pressed="true"]{border-color:var(--eutrofia);color:var(--eutrofia)}
#count{color:var(--muted);font-size:.85rem;font-variant-numeric:tabular-nums}

/* ---------- números ---------- */
.big{font-family:var(--serif);font-size:clamp(3.6rem,9vw,7rem);line-height:.86;
  font-variant-numeric:tabular-nums;letter-spacing:-.03em}
.kpis{display:flex;flex-wrap:wrap;gap:clamp(18px,3.4vw,52px)}
.kpi .v{font-family:var(--serif);font-size:clamp(2rem,4vw,3.1rem);line-height:1;
  font-variant-numeric:tabular-nums}
.kpi .l{color:var(--muted);font-size:.86rem;margin-top:6px;max-width:26ch}

/* ---------- gráficos ---------- */
.card{background:var(--surf2);border:1px solid var(--line);border-radius:14px;padding:16px 18px;min-height:0}
svg{display:block;width:100%;height:auto;overflow:visible}
.axis{fill:var(--muted);font-size:11px;font-family:var(--sans)}
.gridline{stroke:var(--line)}
.dot{cursor:pointer}
.dot:hover{stroke:var(--ink);stroke-width:1.6}

/* ---------- legenda / listas ---------- */
.legend{display:flex;flex-wrap:wrap;gap:6px}
.tab{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--line);background:transparent;
  color:var(--muted);border-radius:999px;padding:6px 12px;font:inherit;font-size:.8rem;cursor:pointer}
.tab .sw{width:9px;height:9px;border-radius:50%}
.tab[aria-pressed="true"]{color:var(--ink);border-color:currentColor}
.tab.off{opacity:.38}
select{background:var(--surf);color:var(--ink);border:1px solid var(--line);border-radius:8px;
  padding:7px 10px;font:inherit;font-size:.85rem;max-width:100%}

table{border-collapse:collapse;width:100%;font-size:.88rem}
th{text-align:left;font-weight:600;color:var(--muted);font-size:.78rem;padding:6px 10px 6px 0;
  border-bottom:1px solid var(--line)}
td{padding:7px 10px 7px 0;border-bottom:1px solid rgba(233,241,237,.07);
  font-variant-numeric:tabular-nums}
.scroll{overflow:auto;min-height:0;flex:1;padding-right:6px}
.scroll::-webkit-scrollbar{width:8px}
.scroll::-webkit-scrollbar-thumb{background:var(--line);border-radius:8px}

.caso{border-left:3px solid var(--verificar);background:var(--surf2);border-radius:0 10px 10px 0;
  padding:12px 16px;margin-bottom:10px}
.caso .who{font-family:var(--serif);font-size:1.05rem}
.caso .why{color:var(--muted);font-size:.88rem}
.caso .num{font-variant-numeric:tabular-nums;color:var(--verificar);font-size:.84rem;margin-top:3px}

.chk{display:flex;gap:14px;align-items:flex-start;width:100%;text-align:left;background:transparent;
  border:0;border-bottom:1px solid var(--line);padding:16px 4px;cursor:pointer;color:inherit;font:inherit}
.chk .box{flex:none;width:22px;height:22px;border:1.5px solid var(--muted);border-radius:6px;
  margin-top:2px;display:grid;place-items:center;font-size:13px;color:var(--bg)}
.chk[aria-pressed="true"] .box{background:var(--eutrofia);border-color:var(--eutrofia)}
.chk[aria-pressed="true"] .t{text-decoration:line-through;color:var(--muted)}
.chk .t{font-family:var(--serif);font-size:1.15rem}
.chk .d{color:var(--muted);font-size:.86rem;margin-top:3px}

#tip{position:fixed;pointer-events:none;background:var(--surf);border:1px solid var(--line);
  border-radius:10px;padding:9px 12px;font-size:.83rem;opacity:0;transition:opacity .12s;z-index:60;
  box-shadow:0 12px 30px rgba(0,0,0,.45);max-width:250px}
#tip b{display:block;font-family:var(--serif);font-size:.98rem;margin-bottom:3px}
#tip .m{color:var(--muted);font-variant-numeric:tabular-nums}

.rule{height:1px;background:var(--line);border:0;margin:2px 0}
.hint{color:var(--muted);font-size:.8rem}
@media (max-width:820px){
  .split,.split.wide{grid-template-columns:1fr}
  .slide{padding:22px 20px 96px}
  #bar{height:auto;padding:10px 20px;flex-wrap:wrap}
}
</style>
</head>
