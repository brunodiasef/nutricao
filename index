      svg.appendChild(el('text',{x:(x+w/2).toFixed(1),y:48,'text-anchor':'middle',
        fill:'#0B1F1B','font-size':17,'font-weight':600})).textContent=cont[k];
      svg.appendChild(el('text',{x:(x+w/2).toFixed(1),y:92,'text-anchor':'middle',class:'axis'}))
        .textContent=CAT[k].n;
    }
    x+=w;
  });
  c.appendChild(svg);

  const t=document.createElement('table');
  t.innerHTML='<tr><th>Classificação</th><th>Alunos</th><th>Meninas</th><th>Meninos</th></tr>'+
    ORD.map(k=>{
      const f=validos.filter(a=>a.c===k&&a.s==='F').length, m=validos.filter(a=>a.c===k&&a.s==='M').length;
      return `<tr><td><span style="color:${CAT[k].c}">●</span> ${CAT[k].n}</td>
        <td>${cont[k]} <span style="color:var(--muted)">(${pct(cont[k],validos.length)})</span></td>
        <td>${f}</td><td>${m}</td></tr>`;
    }).join('');
  const c2=document.createElement('div'); c2.className='card'; c2.appendChild(t);
  p.append(c,c2); d.appendChild(p);
  return d;
});

/* 4 — curva interativa */
S('Curva OMS',()=>{
  const d=document.createElement('div'); d.className='split wide';
  const estado={sexo:'F',cats:new Set(ORD),turma:'__all'};
  const left=document.createElement('div'); left.className='pane';
  left.innerHTML=`<p class="eyebrow">Explorar</p>
    <h2>Cada aluno na curva da OMS</h2>
    <p class="lead">As linhas são os limites de escore-z da OMS. Acima de +1 é sobrepeso,
    acima de +2 é obesidade. Passe o mouse em um ponto para ver o aluno.</p>`;

  const seg=document.createElement('div'); seg.className='legend';
  [['F','Meninas'],['M','Meninos']].forEach(([v,rot])=>{
    const b=document.createElement('button'); b.className='tab'; b.textContent=rot;
    b.setAttribute('aria-pressed',estado.sexo===v);
    b.onclick=()=>{estado.sexo=v;redraw();};
    seg.appendChild(b);
  });
  const sel=document.createElement('select');
  sel.setAttribute('aria-label','Filtrar por turma');
  const turmas=[...new Set(A.map(a=>a.t))].sort();
  sel.innerHTML='<option value="__all">Todas as turmas</option>'+
    turmas.map(t=>`<option value="${t}">${t}</option>`).join('');
  sel.onchange=()=>{estado.turma=sel.value;redraw();};

  const leg=document.createElement('div'); leg.className='legend';
  ORD.forEach(k=>{
    const b=document.createElement('button'); b.className='tab';
    b.innerHTML=`<span class="sw" style="background:${CAT[k].c}"></span>${CAT[k].n}`;
    b.setAttribute('aria-pressed','true');
    b.onclick=()=>{
      if(estado.cats.has(k)&&estado.cats.size>1){estado.cats.delete(k);b.classList.add('off');b.setAttribute('aria-pressed','false');}
      else {estado.cats.add(k);b.classList.remove('off');b.setAttribute('aria-pressed','true');}
      redraw();
    };
    leg.appendChild(b);
  });
  const info=document.createElement('p'); info.className='hint';
  left.append(seg,sel,leg,info);

  const right=document.createElement('div'); right.className='pane';
  const card=document.createElement('div'); card.className='card';
  right.appendChild(card);
  function redraw(){
    [...seg.children].forEach((b,i)=>b.setAttribute('aria-pressed', estado.sexo===(i?'M':'F')));
    const g=curvaOMS(estado);
    card.innerHTML=''; card.appendChild(g.svg);
    info.textContent=`${g.n} aluno${g.n===1?'':'s'} no gráfico.`;
  }
  redraw();
  d.append(left,right);
  return d;
});

/* 5 — turmas */
S('Turmas',()=>{
  const d=document.createElement('div'); d.className='split';
  const turmas={};
  validos.forEach(a=>{
    turmas[a.t]=turmas[a.t]||{n:0,e:0};
    turmas[a.t].n++;
    if(['sobrepeso','obesidade','grave'].includes(a.c)) turmas[a.t].e++;
  });
  const itens=Object.entries(turmas).filter(([,v])=>v.n>=10)
    .map(([k,v])=>({k,v:100*v.e/v.n,e:v.e,n:v.n,
      cor:(100*v.e/v.n)>=50?'var(--grave)':(100*v.e/v.n)>=35?'var(--obesidade)':'var(--sobrepeso)',
      tip:`<b>${k}</b><span class="m">${v.e} de ${v.n} alunos com excesso de peso</span>`}))
    .sort((a,b)=>b.v-a.v);
  d.innerHTML=`<div class="pane">
    <p class="eyebrow">Por turma</p>
    <h2>Onde o excesso se concentra</h2>
    <p class="lead">Turmas com pelo menos 10 alunos medidos, ordenadas pela proporção de
    sobrepeso e obesidade. As duas primeiras merecem uma checagem antes de virar meta —
    veja o slide seguinte.</p></div>`;
  const p=document.createElement('div'); p.className='pane';
  const c=document.createElement('div'); c.className='card scroll';
  c.appendChild(barras(itens,{max:100,rotulo:it=>it.v.toFixed(0)+'%'}));
  p.appendChild(c); d.appendChild(p);
  return d;
});

/* 6 — alerta de balança */
S('Consistência',()=>{
  const d=document.createElement('div'); d.className='split';
  const alvo=['7ºIM01-EF','7ºIM02-EF','7ºIM03-EF','8ºIM01-EF','8ºIM02-EF','8ºIM03-EF'];
  const itens=alvo.map(t=>{
    const g=validos.filter(a=>a.t===t);
    const pm=g.reduce((s,a)=>s+a.p,0)/g.length;
    const hm=g.reduce((s,a)=>s+a.h,0)/g.length;
    return {k:t,v:pm,cor:['7ºIM02-EF','8ºIM03-EF'].includes(t)?'var(--grave)':'var(--eutrofia)',
      tip:`<b>${t}</b><span class="m">${g.length} alunos<br>peso médio ${pm.toFixed(1).replace('.',',')} kg<br>altura média ${hm.toFixed(0)} cm</span>`};
  });
  d.innerHTML=`<div class="pane">
    <p class="eyebrow">Antes de fechar o relatório</p>
    <h2>Duas turmas destoam das paralelas</h2>
    <p class="lead">A 7ºIM02 tem peso médio 12,5 kg acima das outras duas sétimas séries,
    com a mesma idade. A 8ºIM03 está 13 kg acima das outras oitavas.
    Diferença dessa ordem entre turmas do mesmo ano não costuma ser real.</p>
    <p class="lead"><b>O que fazer:</b> confirmar se a balança e o estadiômetro usados
    nessas duas turmas foram os mesmos das demais. Se houver descalibração,
    o percentual geral da escola cai.</p></div>`;
  const p=document.createElement('div'); p.className='pane';
  const c=document.createElement('div'); c.className='card';
  const h=document.createElement('p'); h.className='hint'; h.textContent='Peso médio por turma (kg)';
  c.append(h,barras(itens,{rotulo:it=>it.v.toFixed(1).replace('.',',')}));
  p.appendChild(c); d.appendChild(p);
  return d;
});

/* 7 — medidas a conferir */
S('A conferir',()=>{
  const d=document.createElement('div'); d.className='split';
  d.innerHTML=`<div class="pane">
    <p class="eyebrow">Qualidade dos dados</p>
    <h2>Seis erros corrigidos, um caso em aberto</h2>
    <p class="lead">A conferência com os alunos resolveu as medidas impossíveis:
    dois casos de peso e altura trocados na digitação, três vírgulas fora do lugar
    e uma altura remedida. Todos já entraram nas estatísticas.</p>
    <p class="lead">Resta ${conferir.length} registro sinalizado, e só porque o peso
    ficou abaixo do limite automático de 25 kg. Se a balança estiver certa,
    é uma medida válida.</p>
    <p class="lead">Continuam pendentes as duas linhas soltas no fim da planilha oficial,
    “Jhuly” e “Matheus Vitor”, sem turma nem cadastro. Se forem alunos novos,
    precisam entrar pela aba <b>Inserir novos alunos</b>.</p></div>`;
  const p=document.createElement('div'); p.className='pane';
  const c=document.createElement('div'); c.className='card scroll';
  conferir.forEach(a=>{
    const box=document.createElement('div'); box.className='caso';
    box.innerHTML=`<div class="who">${nome(a)}</div>
      <div class="num">${a.t} · ${a.a} anos · ${br(a.p)} kg · ${a.h} cm</div>
      <div class="why">${HIP[nome(a)]||'Confirmar a medida'}</div>`;
    c.appendChild(box);
  });
  p.appendChild(c); d.appendChild(p);
  return d;
});

/* 8 — estatura */
S('Estatura',()=>{
  const d=document.createElement('div'); d.className='split';
  const adeq=A.filter(a=>a.ze!==null&&a.c!=='verificar'&&a.ze>=-2).length;
  d.innerHTML=`<div class="pane">
    <p class="eyebrow">O outro indicador</p>
    <h2>${baixaEst.length} casos de baixa estatura</h2>
    <p class="lead">Estatura para idade abaixo de −2 escores-z, o que sugere restrição
    de crescimento acumulada. São poucos casos, e por isso dá para tratar cada um
    individualmente: encaminhamento à unidade de saúde e conversa com a família.</p>
    <div class="kpis">
      <div class="kpi"><div class="v" style="color:var(--eutrofia)">${adeq}</div><div class="l">estatura adequada</div></div>
      <div class="kpi"><div class="v" style="color:var(--sobrepeso)">${baixaEst.filter(a=>a.ze>=-3).length}</div><div class="l">baixa estatura</div></div>
      <div class="kpi"><div class="v" style="color:var(--grave)">${baixaEst.filter(a=>a.ze<-3).length}</div><div class="l">muito baixa estatura</div></div>
    </div></div>`;
  const p=document.createElement('div'); p.className='pane';
  const c=document.createElement('div'); c.className='card scroll';
  const t=document.createElement('table');
  t.innerHTML='<tr><th>Aluno</th><th>Turma</th><th>Idade</th><th>Altura</th><th>Escore-z</th></tr>'+
    baixaEst.map(a=>`<tr><td>${nome(a)}</td><td style="color:var(--muted)">${a.t}</td>
      <td>${a.a}</td><td>${a.h} cm</td>
      <td style="color:${a.ze<-3?'var(--grave)':'var(--sobrepeso)'}">${br(a.ze.toFixed(2))}</td></tr>`).join('');
  c.appendChild(t); p.appendChild(c); d.appendChild(p);
  return d;
});

/* 9 — plano */
S('Plano',()=>{
  const d=document.createElement('div'); d.className='split';
  d.innerHTML=`<div class="pane">
    <p class="eyebrow">Próximos passos</p>
    <h2>O que fica para a escola</h2>
    <p class="lead">Marque conforme for concluindo. Os três primeiros itens
    fecham a coleta; os dois últimos são o trabalho de fato.</p></div>`;
  const p=document.createElement('div'); p.className='pane';
  const c=document.createElement('div'); c.className='card scroll';
  [['Medir os 103 alunos que faltam','Prioridade para 6ºIM03 e as três turmas de EJA-EP-ADC, que somam 42 alunos.'],
   ['Liberar a última medida sinalizada','Só o peso de um aluno do 6ºIM01 ficou abaixo do limite automático; confirmar e liberar.'],
   ['Cadastrar Jhuly e Matheus Vitor','Pela aba “Inserir novos alunos”, com id, turma e data de nascimento.'],
   ['Checar a balança da 7ºIM02 e da 8ºIM03','Antes de tratar essas turmas como prioridade de intervenção.'],
   [`Encaminhar os casos individuais`,`${validos.filter(a=>a.c==='grave').length} alunos com obesidade grave e ${baixaEst.length} com baixa estatura, com a família avisada.`],
   [`Levar o resultado ao conselho de classe`,`${excesso.length} alunos com excesso de peso é pauta de escola inteira, não só da Educação Física.`]
  ].forEach(([t,dd])=>{
    const b=document.createElement('button'); b.className='chk'; b.setAttribute('aria-pressed','false');
    b.innerHTML=`<span class="box">✓</span><span><span class="t">${t}</span><span class="d" style="display:block">${dd}</span></span>`;
    b.onclick=()=>b.setAttribute('aria-pressed', b.getAttribute('aria-pressed')==='true'?'false':'true');
    c.appendChild(b);
  });
  p.appendChild(c); d.appendChild(p);
  return d;
});

/* ============ navegação ============ */
const deck=document.getElementById('deck'), dots=document.getElementById('dots'),
      count=document.getElementById('count');
let atual=0;
slides.forEach((s,i)=>{
  const b=document.createElement('button');
  b.setAttribute('role','tab'); b.setAttribute('aria-label',s.nome);
  b.onclick=()=>ir(i); dots.appendChild(b);
});
function ir(i){
  atual=Math.max(0,Math.min(slides.length-1,i));
  hideTip(); deck.innerHTML='';
  const sec=document.createElement('section');
  sec.className='slide'; sec.appendChild(slides[atual].build());
  deck.appendChild(sec);
  [...dots.children].forEach((b,j)=>b.setAttribute('aria-current', j===atual));
  count.textContent=`${atual+1} / ${slides.length}`;
  document.title=slides[atual].nome+' — Diagnóstico Nutricional';
}
document.getElementById('prev').onclick=()=>ir(atual-1);
document.getElementById('next').onclick=()=>ir(atual+1);
addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key==='PageDown'){ir(atual+1);}
  else if(e.key==='ArrowLeft'||e.key==='PageUp'){ir(atual-1);}
  else if(e.key==='Home'){ir(0);} else if(e.key==='End'){ir(slides.length-1);}
});
const btnAnon=document.getElementById('anon');
btnAnon.onclick=()=>{
  anon=!anon; btnAnon.setAttribute('aria-pressed',anon);
  btnAnon.textContent=anon?'Mostrar nomes':'Ocultar nomes'; ir(atual);
};
ir(0);
</script>
